# ============================================
# EDTECH AI — Environment Configuration
# ============================================

# Database
DATABASE_URL=sqlite:///./edtech_ai.db

# JWT Authentication
JWT_ACCESS_SECRET=edtech-ai-local-access-secret-2026-8f1c9b4e7a2d6f3c5b8e1a9d4c7f2b6e
JWT_REFRESH_SECRET=edtech-ai-local-refresh-secret-2026-3d7a1f9c5e8b2a6d4f1c7e9b3a5d8f2c
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Auto-seed demo data (set to false in production)
AUTO_SEED=true

# Email / SMTP Configuration
# Required for real email delivery. Without these, emails are logged to console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=EDTECH AI
SMTP_USE_TLS=true

# AI Provider
# Options: "baseline" (default, no API key needed) or "openai"
AI_PROVIDER=baseline
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# Development settings
NODE_ENV=development
PORT=8000